<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>blog</title>
    <link rel="stylesheet" href="home.css">
    <link rel="stylesheet" href="blogs.css">
</head>
<body>
    <%- include("./components/navbar") %>


  <!-- blogs -->

  <section class="blogs">

    <!-- card 1 -->
<% blogs.forEach((blog)=>{ %>
     <div class="card">

      <img src="<%- blog.image %>" alt="">

      <div class="content">

        <h2><%- blog.title%></h2> 

        <p>
          <%- blog.description %>
        </p>

        <a href="/singleblog/<%- blog.id %>" class="btn">
          Read More
        </a>

      </div>

    </div>

<% }) %>
 

  </section>
</body>
</html>
